#!/bin/sh
# Installed via tools/install-git-hooks.bat (Windows) or
# tools/install-git-hooks.sh (macOS/Linux). See README.md, section
# "Git hook integration".
#
# Atomic, per exercise: for each staged exercises/stageNN/exerciseXX/*.py
# (or exams/examNN/solution.py, or challenges/challengeNN/solution.py),
# runs "python tools/cli.py test <id>" for that ONE exercise/exam/challenge
# -- not its whole stage, and not the whole suite. A commit that doesn't
# touch any exercise/exam/challenge file passes through untested (nothing
# to check). pre-push runs the exact same per-exercise check again on
# whatever actually changes on the remote, so nothing that skipped this
# hook (e.g. a commit made with --no-verify) ships broken.

HOOK_DIR=$(dirname "$0")

echo "pre-commit: checking staged exercise/exam/challenge files (per-exercise)..."
git diff --cached --name-only --diff-filter=ACM | sh "$HOOK_DIR/run-tests-for-changed-files.sh"
status=$?

if [ $status -ne 0 ]; then
    echo ""
    echo "pre-commit: tests failed -- commit aborted."
    echo "Fix the failing tests, then commit again, or skip this check once with:"
    echo "    git commit --no-verify"
    exit 1
fi

exit 0
