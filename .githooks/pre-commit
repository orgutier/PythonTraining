#!/bin/sh
# Installed via tools/install-git-hooks.bat (Windows) or
# tools/install-git-hooks.sh (macOS/Linux). See README.md, section
# "Git hook integration".
#
# Only tests what's actually staged: for each staged
# exercises/weekNN/solution.py or challenges/challengeNN/solution.py,
# runs "python tools/cli.py test <id>" for that one week/challenge --
# not the whole suite. A commit that doesn't touch any solution.py
# passes through untested (nothing to check).

HOOK_DIR=$(dirname "$0")

echo "pre-commit: checking staged solution.py files..."
git diff --cached --name-only --diff-filter=ACM | sh "$HOOK_DIR/run-tests-for-changed-files.sh"
status=$?

if [ $status -ne 0 ]; then
    echo ""
    echo "pre-commit: tests failed -- commit aborted."
    echo "Fix the failing tests, then commit again, or skip this check once with:"
    echo "    git commit --no-verify"
    exit 1
fi

exit 0
