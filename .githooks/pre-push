#!/bin/sh
# Installed via tools/install-git-hooks.bat (Windows) or
# tools/install-git-hooks.sh (macOS/Linux). See README.md, section
# "Git hook integration".
#
# Whole week, not just what changed: for each exercises/weekNN/exerciseXX/*.py
# (or challenges/challengeNN/solution.py) that differs between the remote
# ref and what's being pushed, runs "python tools/cli.py test <id>" for
# that entire week/challenge -- every exercise in a week you touched, not
# just the one(s) that changed, and not the whole suite. This is
# deliberately broader than pre-commit's per-exercise check: it catches a
# week left inconsistent by commits made with --no-verify, or an earlier
# exercise a later change in the same week accidentally broke. A push
# that doesn't touch any exercise/challenge file passes through untested
# (nothing to check).
#
# Git feeds this hook one line per ref being pushed on stdin:
#   <local ref> <local sha1> <remote ref> <remote sha1>

HOOK_DIR=$(dirname "$0")
ZERO="0000000000000000000000000000000000000000"
overall_status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "$ZERO" ]; then
        continue  # deleting the remote ref -- nothing to test
    fi

    if [ "$remote_sha" = "$ZERO" ]; then
        # Brand-new ref on the remote: nothing to diff against, so
        # every solution.py that exists at this commit counts as "changed".
        changed=$(git ls-tree -r --name-only "$local_sha")
    else
        changed=$(git diff --name-only --diff-filter=ACM "$remote_sha" "$local_sha")
    fi

    echo "pre-push: checking exercise/challenge files changing on $remote_ref (whole week per exercise touched)..."
    echo "$changed" | sh "$HOOK_DIR/run-tests-for-changed-files.sh" week
    status=$?
    if [ $status -ne 0 ]; then
        overall_status=1
    fi
done

if [ $overall_status -ne 0 ]; then
    echo ""
    echo "pre-push: tests failed -- push aborted."
    echo "Fix the failing tests, then push again, or skip this check once with:"
    echo "    git push --no-verify"
    exit 1
fi

exit 0
